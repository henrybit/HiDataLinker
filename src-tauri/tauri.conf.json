{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HiDataLinker",
  "version": "1.1.0",
  "identifier": "com.dbgui.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm fetch:bundled-node && pnpm agents-runtime:build && pnpm dev",
    "beforeBuildCommand": "pnpm fetch:bundled-node && pnpm agents-runtime:build && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HiDataLinker",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../agents-runtime/dist/main.mjs": "agents-runtime/main.mjs"
    },
    "externalBin": [
      "binaries/node"
    ]
  }
}
